# Dependencies
node_modules/
package.json
package-lock.json
bun.lock

# Secrets — NEVER commit
alibaba-cloud.apikey
.env
*.secret

# Ephemeral session files
session-*.md

# OS junk
.DS_Store

# Per-machine config layer (auto-merged on top of opencode.json).
# Usually a symlink to one of the per-machine variants below.
opencode.jsonc
# Per-machine .jsonc variants (opencode.jsonc.kimi, ...)
opencode.jsonc.*

# Per-machine variants (opencode.kilocode.json, opencode.anthropic.json, ...)
# and the legacy opencode.local.json. Does NOT match opencode.json itself.
opencode.*.json
opencode.json.bak-*

# direnv
.envrc
.direnv/

# OpenCode v2 background-service credentials (server password) — NEVER commit
service.json

# permission-model plugin: per-machine override
permission-model.local.json
# large audit corpus (5 MB); rebuild per scripts/permission-model/fixtures/README.md
scripts/permission-model/fixtures/audit-commands.json
# real-command tables, generated locally by scripts/permission-model/build-expected.mjs (they contain real commands)
scripts/permission-model/fixtures/expected-decisions.json
scripts/permission-model/fixtures/known-divergences.json
docs/permission-model-expected-decisions.md
